# ==============================================================================
# CONFIGURACIÓN DE DESPLIEGUE - STAGE 2 SOA SEARCH ENGINE
# ==============================================================================

# --- PUERTOS FRONT-END Y OPERACIONALES ---
SEARCH_PORT=7000
INGESTION_PORT=7001
INDEXING_PORT=7002

# --- ESCALABILIDAD Y RÉPLICAS DE SERVICIOS ---
# Réplicas de search-service balanceadas por Nginx
SEARCH_REPLICAS=2
# Réplicas consumidoras de indexing-service
INDEXING_REPLICAS=1

# --- COORDINACIÓN Y MENSAJERÍA ---
HZ_CLUSTER_NAME=dev
HZ_ADDRESS=hazelcast:5701
ACTIVEMQ_URL=tcp://activemq:61616

# --- CONCURRENCIA Y REINTENTOS EN INDEXACIÓN ---
INDEX_WORKER_THREADS=4
JMS_CONSUMERS=2
MAX_RETRIES=3
INDEXING_TIMEOUT_MS=300000

# --- RUTAS DE ALMACENAMIENTO (CONTENEDORES) ---
DATALAKE_PATH=/data/datalake
SQLITE_DB_PATH=/data/datamarts/metadata.db

# --- LÍMITES DE MEMORIA HEAP (JVM) ---
ACTIVEMQ_MAX_HEAP=256m
INGESTION_MAX_HEAP=512m
INDEXING_MAX_HEAP=512m
SEARCH_MAX_HEAP=512m

# --- LÍMITES DE RECURSOS DOCKER (CPU Y MEMORIA) ---
ACTIVEMQ_CPUS=1.0
ACTIVEMQ_MEM_LIMIT=512M

HAZELCAST_CPUS=1.0
HAZELCAST_MEM_LIMIT=512M

INGESTION_CPUS=1.0
INGESTION_MEM_LIMIT=768M

INDEXING_CPUS=1.5
INDEXING_MEM_LIMIT=1024M

SEARCH_CPUS=1.0
SEARCH_MEM_LIMIT=768M

